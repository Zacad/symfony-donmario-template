<?php

declare(strict_types=1);

namespace App\Module\CollectionChecking\Application\Values;

use App\Module\CollectionChecking\Application\Inspect\ChoiceResult;
use App\Platform\Authorization\Authorize;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;
use Symfony\Component\Uid\Uuid;

#[AsMessageHandler(bus: 'query.bus')]
#[Authorize(public: true)]
final readonly class ValuesHandler
{
    public function __invoke(ValuesQuery $query): string|int|float|bool|null|Uuid|\DateTimeImmutable|ChoiceResult
    {
        return match ($query->kind) {
            'string' => 'value',
            'int' => 42,
            'float' => 1.5,
            'bool' => false,
            'uuid' => Uuid::fromString('01994585-4400-7000-8000-000000000001'),
            'date' => new \DateTimeImmutable('2026-09-14T00:00:00Z'),
            'enum' => ChoiceResult::Ready,
            default => null,
        };
    }
}
