<?php

declare(strict_types=1);

use App\Module\CollectionChecking\Application\Collect\CollectCommand;
use App\Module\CollectionChecking\Application\Collect\CollectResult;
use App\Module\CollectionChecking\Application\Collect\ItemInput;
use App\Module\CollectionChecking\Application\Inspect\InspectQuery;
use App\Module\CollectionChecking\Application\Inspect\InspectResult;
use App\Module\CollectionChecking\Application\Record\RecordCommand;
use Doctrine\DBAL\DriverManager;
use Doctrine\ORM\Event\PostFlushEventArgs;
use Doctrine\ORM\Events;
use PHPUnit\Framework\Assert;

$kernel = require __DIR__.'/bootstrap.php';
$container = $kernel->getContainer();
$commands = $container->get('test.collections.commands');
$queries = $container->get('test.collections.queries');
$manager = $container->get('doctrine.orm.default_entity_manager');
$db = $container->get('doctrine.dbal.default_connection');
Assert::assertSame('app_test', $db->fetchOne('SELECT current_database()'));
Assert::assertSame('app', $db->fetchOne('SELECT current_user'));
$observer = DriverManager::getConnection($db->getParams());
Assert::assertSame('app_test', $observer->fetchOne('SELECT current_database()'));
$prefix = $argv[1];
Assert::assertMatchesRegularExpression('/^collections-[a-f0-9]{16}$/D', $prefix);
$label = '';
$manager->getEventManager()->addEventListener([Events::postFlush], new class($observer, $label) {
    public function __construct(private readonly Doctrine\DBAL\Connection $observer, private string &$label)
    {
    }

    public function postFlush(PostFlushEventArgs $event): void
    {
        $db = $event->getObjectManager()->getConnection();
        file_put_contents(__DIR__.'/flush.jsonl', json_encode([
            'label' => $this->label,
            'local_task' => $db->fetchOne('SELECT count(*) FROM task_tracking_task WHERE title = ?', [$this->label]),
            'outside_task' => $this->observer->fetchOne('SELECT count(*) FROM task_tracking_task WHERE title = ?', [$this->label]),
            'local_observation' => $db->fetchOne('SELECT count(*) FROM collection_checking_observation WHERE label = ?', [$this->label]),
            'outside_observation' => $this->observer->fetchOne('SELECT count(*) FROM collection_checking_observation WHERE label = ?', [$this->label]),
            'active' => $db->isTransactionActive(),
        ], JSON_THROW_ON_ERROR)."\n", FILE_APPEND | LOCK_EX);
    }
});

file_put_contents(__DIR__.'/transactions.txt', '');
$proof = [];
foreach (['invalid', 'caught-command', 'caught-query'] as $mode) {
    $label = $prefix.'-'.$mode;
    $beforeFlush = file_get_contents(__DIR__.'/flush.jsonl');
    $beforeTransactions = file_get_contents(__DIR__.'/transactions.txt');
    try {
        $commands->dispatch(new CollectCommand($label, ['one', 'two'], [new ItemInput('item')], new ItemInput('nested'), $mode));
        Assert::fail('Invalid output must abort the root command: '.$mode);
    } catch (LogicException $failure) {
        Assert::assertSame('cqrs.result_validation: Handler returned invalid data.', $failure->getMessage());
        Assert::assertNull($failure->getPrevious());
    }
    $transactions = substr(file_get_contents(__DIR__.'/transactions.txt'), strlen($beforeTransactions));
    Assert::assertSame("Beginning transaction\nRolling back transaction\n", $transactions);
    Assert::assertSame($beforeFlush, file_get_contents(__DIR__.'/flush.jsonl'), 'Invalid output is rejected before root ORM flush.');
    Assert::assertSame(0, $observer->fetchOne('SELECT count(*) FROM collection_checking_observation WHERE label LIKE ?', [$label.'%']));
    Assert::assertSame(0, $observer->fetchOne('SELECT count(*) FROM task_tracking_task WHERE title LIKE ?', [$label.'%']));

    $label = $prefix.'-recovery-'.$mode;
    $beforeTransactions = file_get_contents(__DIR__.'/transactions.txt');
    $result = $commands->dispatch(new CollectCommand($label, 'invalid' === $mode ? [] : ['one', 'two'], 'invalid' === $mode ? [] : [new ItemInput('item')], new ItemInput('recovered')));
    Assert::assertInstanceOf(CollectResult::class, $result);
    Assert::assertSame('recovered', $result->items[0]->name);
    Assert::assertSame("Beginning transaction\nCommitting transaction\n", substr(file_get_contents(__DIR__.'/transactions.txt'), strlen($beforeTransactions)));
    Assert::assertSame(1, $observer->fetchOne('SELECT count(*) FROM task_tracking_task WHERE title = ?', [$label]));
    Assert::assertSame(1, $observer->fetchOne('SELECT count(*) FROM collection_checking_observation WHERE label = ?', [$label]));
    Assert::assertSame($manager, $container->get('doctrine.orm.default_entity_manager'));
    Assert::assertTrue($manager->isOpen());
    Assert::assertSame($commands, $container->get('test.collections.commands'));
    Assert::assertInstanceOf(InspectResult::class, $queries->ask(new InspectQuery()));
    $proof[$mode] = ['rolled_back' => true, 'recovered' => true];
}

$beforeTransactions = file_get_contents(__DIR__.'/transactions.txt');
try {
    $queries->ask(new InspectQuery('invalid'));
    Assert::fail('Invalid query result must be an internal error.');
} catch (LogicException $failure) {
    Assert::assertSame('cqrs.result_validation: Handler returned invalid data.', $failure->getMessage());
}
Assert::assertSame($beforeTransactions, file_get_contents(__DIR__.'/transactions.txt'), 'Queries do not open a transaction.');
Assert::assertInstanceOf(InspectResult::class, $queries->ask(new InspectQuery()));
$label = $prefix.'-void';
Assert::assertNull($commands->dispatch(new RecordCommand($label)));
Assert::assertSame(1, $observer->fetchOne('SELECT count(*) FROM collection_checking_observation WHERE label = ?', [$label]));
Assert::assertSame("Beginning transaction\nCommitting transaction\n", substr(file_get_contents(__DIR__.'/transactions.txt'), strlen($beforeTransactions)));
print json_encode($proof, JSON_THROW_ON_ERROR);
$observer->close();
$kernel->shutdown();
