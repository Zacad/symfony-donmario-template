<?php

declare(strict_types=1);

namespace App\Module\EventCompiling\Application\Probe;

use App\Tests\Fixtures\EventCompilation\RuntimeEvidence;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'command.bus')]
final readonly class ProbeHandler
{
    public function __invoke(ProbeCommand $command): void
    {
        RuntimeEvidence::$actions[] = 'command-'.$command->label;
    }
