<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Application\ContinueChain;

use App\Module\EventObserving\Application\EmitEvents\ChainEvent;
use App\Module\EventObserving\Domain\Observation;
use App\Module\EventObserving\Domain\ObservationRepository;
use App\Platform\Messaging\ApplicationEventRecorder;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'command.bus')]
final readonly class ContinueChainHandler
{
    public function __construct(private ObservationRepository $observations, private ApplicationEventRecorder $events, private string $scenario)
    {
    }

    public function __invoke(ContinueChainCommand $command): void
    {
        $this->observations->add(new Observation($command->taskId, 'chain-'.$command->position));
        if (in_array($this->scenario, ['budget', 'zero-budget'], true)) {
            $this->events->record(new ChainEvent($command->taskId, $command->position + 1));
        } elseif ('fifo' === $this->scenario && 1 === $command->position) {
            $this->events->record(new ChainEvent($command->taskId, 3));
        }
    }
}
