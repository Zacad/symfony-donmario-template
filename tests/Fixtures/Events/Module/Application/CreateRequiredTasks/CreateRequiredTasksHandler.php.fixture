<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Application\CreateRequiredTasks;

use App\Module\TaskTracking\Application\CreateTask\CreateTaskCommand;
use App\Module\TaskTracking\Application\GetTask\GetTaskQuery;
use App\Platform\Messaging\CommandBus;
use App\Platform\Messaging\QueryBus;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;
use Symfony\Component\Uid\Uuid;

#[AsMessageHandler(bus: 'command.bus')]
final readonly class CreateRequiredTasksHandler
{
    public function __construct(private CommandBus $commands, private QueryBus $queries, private string $scenario)
    {
    }

    public function __invoke(CreateRequiredTasksCommand $command): Uuid
    {
        $id = $this->commands->dispatch(new CreateTaskCommand($command->title.'-outer'));
        $this->commands->dispatch(new CreateTaskCommand($command->title.'-inner'));
        if ('root-rollback' === $this->scenario) {
            throw new \RuntimeException('EVENT_PRIVATE_FAILURE_CANARY');
        }
        if ('nested-query' === $this->scenario) {
            try {
                $this->queries->ask(new GetTaskQuery('EVENT_PRIVATE_FAILURE_CANARY'));
            } catch (\Throwable) {
                // Required nested failures still invalidate the entire root.
            }
        }
        if (!$id instanceof Uuid) {
            throw new \LogicException('Expected a task identifier.');
        }

        return $id;
    }
}
