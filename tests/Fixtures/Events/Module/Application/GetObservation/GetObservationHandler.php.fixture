<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Application\GetObservation;

use App\Module\EventObserving\Domain\ObservationRepository;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'query.bus')]
final readonly class GetObservationHandler
{
    public function __construct(private ObservationRepository $observations)
    {
    }

    public function __invoke(GetObservationQuery $query): GetObservationResult
    {
        return new GetObservationResult($this->observations->count($query->taskId));
    }
}
