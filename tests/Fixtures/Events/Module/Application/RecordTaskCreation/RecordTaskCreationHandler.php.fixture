<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Application\RecordTaskCreation;

use App\Module\EventObserving\Domain\Observation;
use App\Module\EventObserving\Domain\ObservationRepository;
use App\Platform\Messaging\ApplicationEventRecorder;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'command.bus')]
final readonly class RecordTaskCreationHandler
{
    public function __construct(private ObservationRepository $observations, private ApplicationEventRecorder $events)
    {
    }

    public function __invoke(RecordTaskCreationCommand $command): void
    {
        if (!str_starts_with($command->label, 'child-')) {
            $this->events->record(new ObservationRecordedEvent($command->taskId, $command->label));
        }
        $this->observations->add(new Observation($command->taskId, $command->label));
    }
}
