<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Domain;

use Doctrine\ORM\Mapping as ORM;
use Symfony\Bridge\Doctrine\Types\UuidType;
use Symfony\Component\Uid\Uuid;

#[ORM\Entity]
#[ORM\Table(name: 'event_observing_observation', schema: 'public')]
class Observation
{
    #[ORM\Id]
    #[ORM\Column(type: UuidType::NAME)]
    private Uuid $id;

    public function __construct(
        #[ORM\Column(name: 'task_id', type: UuidType::NAME)] private Uuid $taskId,
        #[ORM\Column(length: 40)] private string $label,
    ) {
        $this->id = Uuid::v7();
    }

    public function id(): Uuid
    {
        return $this->id;
    }

    public function taskId(): Uuid
    {
        return $this->taskId;
    }

    public function label(): string
    {
        return $this->label;
    }
}
