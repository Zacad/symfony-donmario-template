<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Infrastructure\EventListener;

use App\Module\EventObserving\Application\ContinueChain\ContinueChainCommand;
use App\Module\EventObserving\Application\EmitEvents\ChainEvent;
use App\Platform\Messaging\CommandBus;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'application.event.bus')]
final readonly class ChainListener
{
    public function __construct(private CommandBus $commands)
    {
    }

    public function __invoke(ChainEvent $event): void
    {
        $this->commands->dispatch(new ContinueChainCommand($event->taskId, $event->position));
    }
}
