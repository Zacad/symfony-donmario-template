<?php

declare(strict_types=1);

namespace App\Module\EventObserving\Infrastructure\EventListener;

use App\Module\EventObserving\Application\RecordTaskCreation\ObservationRecordedEvent;
use App\Module\EventObserving\Application\RecordTaskCreation\RecordTaskCreationCommand;
use App\Platform\Messaging\CommandBus;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;

#[AsMessageHandler(bus: 'application.event.bus')]
final readonly class ObservationListener
{
    public function __construct(private CommandBus $commands)
    {
    }

    public function __invoke(ObservationRecordedEvent $event): void
    {
        $this->commands->dispatch(new RecordTaskCreationCommand($event->taskId, 'child-'.$event->label));
    }
}
