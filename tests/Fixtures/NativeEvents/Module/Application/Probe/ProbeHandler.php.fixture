<?php

declare(strict_types=1);

namespace App\Module\NativeObserving\Application\Probe;

use App\Module\NativeObserving\Application\Publish\DetailEvent;
use App\Platform\Messaging\EventBus;
use Symfony\Component\Messenger\Attribute\AsMessageHandler;
use Symfony\Component\Uid\Uuid;

#[AsMessageHandler(bus: 'query.bus')]
final readonly class ProbeHandler
{
    public function __construct(private EventBus $events)
    {
    }

    public function __invoke(ProbeQuery $query): bool
    {
        $this->events->dispatch(new DetailEvent(Uuid::v7(), 'query', 0, false, null));

        return true;
    }
}
